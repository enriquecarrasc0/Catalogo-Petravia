server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # La app también se sirve bajo /catalogo/ — por si el proxy externo de
    # petravia.mx reenvía la ruta completa SIN quitar el prefijo (en vez de
    # asumir que siempre lo hace). El modificador "^~" le da prioridad sobre
    # los bloques de abajo para cualquier request que empiece con /catalogo/,
    # así funciona sin depender de cómo esté configurado ese proxy externo.
    location ^~ /catalogo/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ /catalogo/index.html;
    }

    # Assets estáticos con cache largo
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Proxy /api/* → backend. En producción apunta al dominio público de
    # Railway (valor por defecto, ver Dockerfile.web); para pruebas locales
    # se puede sobreescribir con -e API_PROXY_TARGET=http://tu-api-local:3000
    # al correr el contenedor, sin tocar este archivo.
    location /api/ {
        proxy_pass ${API_PROXY_TARGET};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }

    # SPA fallback — cualquier ruta que no sea archivo → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}