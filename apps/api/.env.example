PORT=3000
CORS_ORIGIN=http://localhost:5173

# ADMIN_USER / ADMIN_PASS solo se usan UNA VEZ, la primera vez que arranca
# el servidor con una base de datos vacía: crean el primer vendedor.
# Cámbialos por un usuario y una contraseña propios — no dejes estos valores
# de ejemplo en un despliegue real.
# Para vendedores adicionales usa: cd apps/api && npm run crear-vendedor -- --usuario=... --password=... --nombre="..."
ADMIN_USER=tu-usuario-admin
ADMIN_PASS=tu-contraseña-segura

# Odoo
# ODOO_URL: la URL base de tu instancia (Odoo.sh o Odoo Online), sin rutas
# adicionales al final (ej. https://tuempresa.odoo.com).
# ODOO_DB: nombre exacto de la base de datos — en Odoo.sh puede cambiar
# cada vez que se reconstruye una rama; en Odoo Online, si es una base de
# prueba/duplicada, revisa que no haya expirado.
# ODOO_KEY: API key generada en Odoo (Ajustes → tu usuario → Seguridad de
# la cuenta → Claves de API), NO tu contraseña normal.
ODOO_URL=https://tu-instancia.odoo.com
ODOO_USER=tu-correo@tuempresa.com
ODOO_DB=tu-base-de-datos
ODOO_KEY=tu-api-key-de-odoo

# Correo (Gmail / Google Workspace)
# SMTP_USER debe ser la cuenta de Gmail que envía los correos.
# SMTP_PASS NO es la contraseña normal de Gmail: es una "contraseña de aplicación"
# de 16 caracteres. Se genera en https://myaccount.google.com/apppasswords
# (requiere tener verificación en 2 pasos activada en esa cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicación-de-16-caracteres
EMAIL_FROM="Petravia <tu-correo@gmail.com>"

# Correo de respaldo: solo se usa si un vendedor no tiene email configurado
# en su cuenta. Cada vendedor debería tener su propio email (columna
# `email` en la tabla vendedores) para recibir las notificaciones de SUS
# clientes.
ADMIN_EMAIL=tu-correo@tuempresa.com
