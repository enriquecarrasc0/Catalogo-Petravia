# ─── API ────────────────────────────────────────────────────────
PORT=3000

# URL del frontend para CORS (en Docker, el proxy de Nginx hace /api → api:3000,
# así que el origin es el dominio público del frontend)
CORS_ORIGIN=http://localhost:5173

# ─── Admin ──────────────────────────────────────────────────────
# Solo se usan UNA VEZ, la primera vez que arranca el servidor con una base
# de datos vacía: crean el primer vendedor. Cámbialos por valores propios —
# no dejes estos de ejemplo en un despliegue real.
ADMIN_USER=tu-usuario-admin
ADMIN_PASS=tu-contraseña-segura

# ─── Base de datos ──────────────────────────────────────────────
# En Docker, el volumen se monta en /data. No cambiar en producción Docker.
DB_PATH=/data/petravia.db

# ─── Odoo XML-RPC ───────────────────────────────────────────────
# ODOO_URL: URL base de tu instancia (Odoo.sh u Odoo Online), sin rutas
# adicionales al final (ej. https://tuempresa.odoo.com).
# ODOO_DB: nombre exacto de la base de datos — en Odoo.sh puede cambiar
# cada vez que se reconstruye una rama; en Odoo Online, revisa que la base
# de prueba/duplicada no haya expirado.
# ODOO_KEY: API key generada en Odoo (Ajustes → tu usuario → Seguridad de
# la cuenta → Claves de API), NO tu contraseña normal.
ODOO_URL=https://tu-instancia.odoo.com
ODOO_USER=tu-correo@tuempresa.com
ODOO_DB=tu-base-de-datos
ODOO_KEY=tu-api-key-de-odoo

# ─── SMTP (Gmail con App Password) ─────────────────────────────
# SMTP_PASS = contraseña de aplicación de 16 chars, NO la contraseña normal.
# Se genera en https://myaccount.google.com/apppasswords
# (requiere verificación en 2 pasos activada en esa cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicación-de-16-caracteres
EMAIL_FROM="Petravia <tu-correo@gmail.com>"

# Correo del admin que recibe notificaciones de PDFs
ADMIN_EMAIL=tu-correo@tuempresa.com
