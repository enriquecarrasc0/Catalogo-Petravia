# ── Stage 1: build ────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# NO se pasa VITE_API_URL — el código usa el fallback '/api'
# y Nginx proxea /api/* → api:3000 internamente

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

RUN npm ci --ignore-scripts

COPY packages/shared/ ./packages/shared/
COPY apps/web/ ./apps/web/

# IMPORTANTE: apps/web importa funciones reales de @petravia/shared
# (formatSaldoLote, formatM2, GRUPOS_MATERIALES, etc. — no solo tipos), así
# que Vite necesita el paquete ya compilado en packages/shared/dist antes de
# armar el bundle. Sin este paso, el build fallaba (o silenciosamente
# empaquetaba un import roto) porque dist/ nunca llegaba a existir.
RUN npx tsc -p packages/shared/tsconfig.json
RUN test -f packages/shared/dist/index.js || (echo "❌ packages/shared no generó dist/index.js — revisa el error de tsc arriba." && exit 1)

RUN sed -i '/"ignoreDeprecations"/d; /"noUnusedLocals"/d; /"noUnusedParameters"/d' apps/web/tsconfig.json
RUN sed -i 's/"build": "tsc && vite build"/"build": "vite build"/' apps/web/package.json

RUN npm run build -w apps/web

# ── Stage 2: Nginx ─────────────────────────────────────────────
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# nginx:alpine ya trae un script de arranque que busca archivos *.template
# en /etc/nginx/templates/, sustituye ${VARIABLES} de entorno, y deja el
# resultado en /etc/nginx/conf.d/ — sin tocar las variables PROPIAS de
# nginx como $remote_addr o $scheme (esas no son variables de entorno del
# sistema, así que envsubst las deja intactas).
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# Valor por defecto = el mismo de siempre (producción, Railway). Para
# probar en LOCAL contra tu propia API, sobreescribe al correr el
# contenedor, sin tocar ningún archivo:
#   docker run -e API_PROXY_TARGET=http://host.docker.internal:3000 -p 8080:80 tu-imagen
ENV API_PROXY_TARGET=https://petraviaapi-production.up.railway.app

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]